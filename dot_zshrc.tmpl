# --- Environment ---------------------------------------------------------------
[ -f ~/.secrets ] && source ~/.secrets
export COLORTERM=truecolor
# Claude Code caps colors to 256 inside tmux; this bypasses that. https://github.com/anthropics/claude-code/issues/36785
export CLAUDE_CODE_TMUX_TRUECOLOR=1
typeset -U path
export PATH=$HOME/bin:$HOME/.local/bin:$HOME/.cargo/bin:$PATH
export PATH="$HOME/dev/llama.cpp/build/bin:$PATH"

# asdf shims and completions must precede oh-my-zsh
export PATH="${ASDF_DATA_DIR:-$HOME/.asdf}/shims:$PATH"
fpath=(${ASDF_DATA_DIR:-$HOME/.asdf}/completions $fpath)

# --- Oh My Zsh -----------------------------------------------------------------
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="bira"
plugins=(git mix tmux)
ZSH_TMUX_CONFIG="$HOME/.config/tmux/tmux.conf"
ZSH_DISABLE_COMPFIX=true  # skip insecure-dir audit on every startup

source $ZSH/oh-my-zsh.sh

# Per-machine hostname colour (256-colour codes; unlisted hosts keep the theme colour) + SSH tag
() {
  local -A colors=(lestrade 208 services-vm 39)
  local c=${colors[${HOST%%.*}]}
  [[ -n $c ]] && PROMPT=${PROMPT/\%m/%F{$c}%m%f}
  [[ -n $SSH_CONNECTION ]] && PROMPT=${PROMPT/╭─/╭─%K{238}%F{white} ssh %f%k }
}

# --- Aliases -------------------------------------------------------------------
alias lg="lazygit"
alias vi="nvim"
alias cl="claude"
alias oc="opencode"
alias dot="cd ~/.local/share/chezmoi/"
alias tm="tmux new-session -A -s main"

# --- Tools ---------------------------------------------------------------------
command -v atuin &>/dev/null && eval "$(atuin init zsh)"
command -v zoxide &>/dev/null && eval "$(zoxide init zsh)"

# cache swamp completions to avoid subprocess fork on every shell open
if command -v swamp &>/dev/null; then
  _swamp_comp="${ZDOTDIR:-$HOME}/.zsh_swamp_completions"
  [[ ! -f $_swamp_comp || $_swamp_comp -ot $(command -v swamp) ]] && swamp completions zsh >$_swamp_comp
  source "$_swamp_comp"
fi

# pull + apply dotfiles in the background, at most hourly; never prompts (log in the stamp's .log)
() {
  command -v chezmoi &>/dev/null || return
  local stamp=${XDG_CACHE_HOME:-$HOME/.cache}/chezmoi-autoupdate
  local -a fresh=( $stamp(N.mh-1) )
  (( $#fresh )) && return
  mkdir -p ${stamp:h} && touch $stamp
  chezmoi update --no-tty </dev/null &>$stamp.log &!
}

if command -v wt >/dev/null 2>&1; then eval "$(command wt config shell init zsh)"; fi

# Pi
export PATH="$HOME/.local/bin:$PATH"

[ -f "$HOME/.atuin/bin/env" ] && . "$HOME/.atuin/bin/env"
