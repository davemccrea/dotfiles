{
  "cursor_blink": false,
  "cli_default_open_behavior": "existing_window",
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "agent": {
    "dock": "right",
  },
  "git_panel": {
    "tree_view": false,
    "dock": "left",
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "diff_view_style": "unified",
  "relative_line_numbers": "enabled",
  "theme": {
    "mode": "dark",
    "light": "GitHub Light",
    "dark": "One Dark",
  },
  "ui_font_size": 15,
  "buffer_font_size": 14,
  "buffer_line_height": "standard",
  "buffer_font_family": "JetBrains Mono",
  "vim_mode": true,
  "terminal": {
    "font_size": 14.0,
    "font_family": "JetBrains Mono",
    "shell": {
      "program": "zsh",
    },
  },
  "disable_ai": true,
  "git": {
    "disable_git": false,
    "hunk_style": "staged_hollow",
    "enable_diff": true,
    "inline_blame": {
      "show_commit_summary": false,
      "enabled": true,
    },
  },
}
